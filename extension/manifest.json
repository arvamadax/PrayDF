{
  "manifest_version": 3,
  "name": "PrayDF",
  "version": "1.2.0",
  "permissions": ["contextMenus", "downloads", "webRequest"],
  "host_permissions": ["<all_urls>"],
  "description": "Buka PDF, DOCX, teks, dan gambar secara lokal di browser.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_title": "Buka PrayDF", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" } },
  "background": { "service_worker": "background.js", "scripts": ["background.js"] },
  "browser_specific_settings": { "gecko": { "id": "praydf@arvamadax.github.io", "strict_min_version": "128.0" } }
}
